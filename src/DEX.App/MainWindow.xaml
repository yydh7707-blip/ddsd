<Window x:Class="DEX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DEX.App.Converters"
        Title="COMPIVOX" Height="900" Width="1360" MinHeight="760" MinWidth="1180"
        WindowStyle="None" ResizeMode="CanResize" Background="#08090D" Foreground="#FFF8E9"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:PageMatchConverter x:Key="PageVis"/>
        <conv:SelectedTagConverter x:Key="NavTag"/>
    </Window.Resources>
    <Grid>
    <Canvas x:Name="AuraCanvas" IsHitTestVisible="False" ClipToBounds="True" Background="#08090D">
        <Ellipse Width="1100" Height="1100" Canvas.Left="150" Canvas.Top="-200" Opacity="0.9">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#80FF8C32" Offset="0"/>
                    <GradientStop Color="#40D65A3C" Offset="0.45"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><TransformGroup>
                <TranslateTransform x:Name="AuraWarmX"/><TranslateTransform x:Name="AuraWarmY"/>
                <TranslateTransform x:Name="AuraWarmMX"/><TranslateTransform x:Name="AuraWarmMY"/>
            </TransformGroup></Ellipse.RenderTransform>
            <Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="900" Height="900" Canvas.Left="760" Canvas.Top="260" Opacity="0.9">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5C8C3CA0" Offset="0"/>
                    <GradientStop Color="#2A5A2A70" Offset="0.55"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><TransformGroup>
                <TranslateTransform x:Name="AuraPlumX"/><TranslateTransform x:Name="AuraPlumY"/>
                <TranslateTransform x:Name="AuraPlumMX"/><TranslateTransform x:Name="AuraPlumMY"/>
            </TransformGroup></Ellipse.RenderTransform>
            <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="2000" Height="2000" Canvas.Left="-250" Canvas.Top="-300" Opacity="0.7">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#00000000" Offset="0.55"/>
                    <GradientStop Color="#B8080910" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="16" Height="16" Canvas.Left="90" Canvas.Top="1000" Stroke="#FFCD82" StrokeThickness="1.2" Fill="#33FFD68C" Opacity="0.7">
            <Ellipse.RenderTransform><TransformGroup><TranslateTransform x:Name="Ring1X"/><TranslateTransform x:Name="Ring1Y"/></TransformGroup></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="26" Height="26" Canvas.Left="300" Canvas.Top="1000" Stroke="#FFCD82" StrokeThickness="1.2" Fill="#26FFD68C" Opacity="0.6">
            <Ellipse.RenderTransform><TransformGroup><TranslateTransform x:Name="Ring2X"/><TranslateTransform x:Name="Ring2Y"/></TransformGroup></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="10" Height="10" Canvas.Left="520" Canvas.Top="1000" Stroke="#FFCD82" StrokeThickness="1" Fill="#40FFD68C" Opacity="0.8">
            <Ellipse.RenderTransform><TransformGroup><TranslateTransform x:Name="Ring3X"/><TranslateTransform x:Name="Ring3Y"/></TransformGroup></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="22" Height="22" Canvas.Left="760" Canvas.Top="1000" Stroke="#FFCD82" StrokeThickness="1.2" Fill="#26FFD68C" Opacity="0.6">
            <Ellipse.RenderTransform><TransformGroup><TranslateTransform x:Name="Ring4X"/><TranslateTransform x:Name="Ring4Y"/></TransformGroup></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="14" Height="14" Canvas.Left="980" Canvas.Top="1000" Stroke="#FFCD82" StrokeThickness="1.2" Fill="#33FFD68C" Opacity="0.7">
            <Ellipse.RenderTransform><TransformGroup><TranslateTransform x:Name="Ring5X"/><TranslateTransform x:Name="Ring5Y"/></TransformGroup></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="34" Height="34" Canvas.Left="1180" Canvas.Top="1000" Stroke="#FFCD82" StrokeThickness="1.2" Fill="#1FFFD68C" Opacity="0.5">
            <Ellipse.RenderTransform><TransformGroup><TranslateTransform x:Name="Ring6X"/><TranslateTransform x:Name="Ring6Y"/></TransformGroup></Ellipse.RenderTransform>
        </Ellipse>
    </Canvas>
    <Border BorderBrush="#33C6A15B" BorderThickness="1">
            <Grid>
                        <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#0D0E13" BorderBrush="#33C6A15B" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="22,26,22,22">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#C6A15B" BorderBrush="#9C793C" BorderThickness="1" HorizontalAlignment="Left">
                                                            <TextBlock Text="C" FontSize="13" FontWeight="SemiBold" Foreground="#17130A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                            <TextBlock Text="COMPIVOX" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <TextBlock Text="STUDIO" Style="{StaticResource Eyebrow}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" Margin="18,0,18,18" Background="#0FC6A15B" BorderBrush="#33C6A15B" BorderThickness="1" CornerRadius="12" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="1.0" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ThemeLabel}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="8,4,8,0">
                            <Button Content="{Binding NavHome}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="home" Tag="{Binding Page, Converter={StaticResource NavTag}, ConverterParameter=home}"/>
                            <Button Content="{Binding NavConverter}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="converter" Tag="{Binding Page, Converter={StaticResource NavTag}, ConverterParameter=converter}"/>
                            <Button Content="{Binding NavHistory}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="history" Tag="{Binding Page, Converter={StaticResource NavTag}, ConverterParameter=history}"/>
                            <Button Content="{Binding NavFormats}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="formats" Tag="{Binding Page, Converter={StaticResource NavTag}, ConverterParameter=formats}"/>
                            <Button Content="{Binding NavInstall}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="install" Tag="{Binding Page, Converter={StaticResource NavTag}, ConverterParameter=install}"/>
                            <Button Content="{Binding NavSettings}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="settings" Tag="{Binding Page, Converter={StaticResource NavTag}, ConverterParameter=settings}"/>
                            <Button Content="{Binding NavAccount}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="account" Tag="{Binding Page, Converter={StaticResource NavTag}, ConverterParameter=account}"/>
                            <Button Content="{Binding NavAbout}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="about" Tag="{Binding Page, Converter={StaticResource NavTag}, ConverterParameter=about}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel Grid.Column="1">
                    <Border DockPanel.Dock="Top" Height="56" BorderBrush="#33C6A15B" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragWindow">
                        <DockPanel Margin="28,0,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="—" Style="{StaticResource CaptionButton}" Click="MinimizeClick"/>
                                <Button Content="□" Style="{StaticResource CaptionButton}" Click="MaxClick"/>
                                <Button Content="×" Style="{StaticResource CaptionButton}" Click="CloseClick"/>
                            </StackPanel>
                            <Border Background="#0FC6A15B" BorderBrush="#33C6A15B" BorderThickness="1" CornerRadius="10" Padding="14,7" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="640">
                                <TextBlock Text="{Binding Status}" Foreground="#B5B2BA" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,28,36,36">
                        <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
                            <StackPanel x:Name="PageHome">
                                <TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="{Binding NavHome}" Style="{StaticResource Title}"/>
                                <TextBlock Text="{Binding HomeIntro}" Style="{StaticResource Muted}" Margin="0,10,0,22" MaxWidth="560" HorizontalAlignment="Left"/>
                                <ContentControl Style="{StaticResource DropZone}" AllowDrop="True" MinHeight="240">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DropTitle}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DropFormats}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                            <Button Content="{Binding PickFileLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding BrowseFileCommand}"/>
                                            <Button Content="{Binding PickFolderLabel}" Style="{StaticResource GhostButton}" Command="{Binding BrowseFolderCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ContentControl>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.35*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="RECENT" Style="{StaticResource Eyebrow}"/>
                                        <ItemsControl ItemsSource="{Binding Recent}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}" Padding="16,14">
                                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ENVIRONMENT" Style="{StaticResource Eyebrow}"/>
                                        <ItemsControl ItemsSource="{Binding Tools}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource StatusCard}" Width="210">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding State}" Style="{StaticResource Muted}" Margin="0,10,0,2"/>
                                                            <TextBlock Text="{Binding Version}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PageConverter" Visibility="Collapsed">
                                <TextBlock Text="BUILD" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="{Binding NavConverter}" Style="{StaticResource Title}"/>
                                <Border Style="{StaticResource Card}" Margin="0,18,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="{Binding ProjectName}" FontSize="26" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LanguageName}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding Compatibility}" Margin="0,16,0,0" FontSize="15"/>
                                            <TextBlock Text="{Binding Problem}" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding Resolution}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <UniformGrid Grid.Column="1" Columns="2">
                                            <StackPanel Margin="8"><TextBlock Text="FRAMEWORK" Style="{StaticResource FactLabel}"/><TextBlock Text="{Binding Framework}"/></StackPanel>
                                            <StackPanel Margin="8"><TextBlock Text="OUTPUT" Style="{StaticResource FactLabel}"/><TextBlock Text="{Binding OutputType}"/></StackPanel>
                                            <StackPanel Margin="8"><TextBlock Text="ENTRY" Style="{StaticResource FactLabel}"/><TextBlock Text="{Binding EntryPoint}"/></StackPanel>
                                            <StackPanel Margin="8"><TextBlock Text="STRUCTURE" Style="{StaticResource FactLabel}"/><TextBlock Text="{Binding Structure}"/></StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{Binding RecheckLabel}" Style="{StaticResource GhostButton}" Command="{Binding RecheckCommand}"/>
                                    <Button Content="{Binding InstallCenterLabel}" Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="install"/>
                                    <Button Content="{Binding RestartLabel}" Style="{StaticResource GhostButton}" Command="{Binding RestartCommand}"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EntryLabel}" Style="{StaticResource FactLabel}"/>
                                            <ComboBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"/>
                                            <TextBlock Text="{Binding BuildMethodLabel}" Style="{StaticResource FactLabel}" Margin="0,16,0,4"/>
                                            <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}"/>
                                            <TextBlock Text="{Binding MethodExplanation}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="OUTPUT" Style="{StaticResource FactLabel}"/>
                                            <TextBox Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="DIRECTORY" Style="{StaticResource FactLabel}" Margin="0,12,0,4"/>
                                            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="ARCH" Style="{StaticResource FactLabel}"/>
                                                    <ComboBox ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArchitecture}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="VERSION" Style="{StaticResource FactLabel}"/>
                                                    <TextBox Text="{Binding ProductVersion, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="OPTIONS" Style="{StaticResource Eyebrow}"/>
                                        <WrapPanel>
                                            <CheckBox Content="Console" IsChecked="{Binding ConsoleApp}" IsEnabled="{Binding AllowConsole}"/>
                                            <CheckBox Content="Single file" IsChecked="{Binding SingleFile}" IsEnabled="{Binding AllowSingle}"/>
                                            <CheckBox Content="Self-contained" IsChecked="{Binding SelfContained}" IsEnabled="{Binding AllowSelf}"/>
                                            <CheckBox Content="Dependencies" IsChecked="{Binding IncludeDependencies}" IsEnabled="{Binding AllowDeps}"/>
                                            <CheckBox Content="Optimize" IsChecked="{Binding Optimize}" IsEnabled="{Binding AllowOptimize}"/>
                                            <CheckBox Content="Compression" IsChecked="{Binding Compression}" IsEnabled="{Binding AllowCompression}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Background="#141319">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SandboxNote}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{Binding ConsentText}" IsChecked="{Binding Consent}" IsEnabled="{Binding CanBuild}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="Build EXE" Style="{StaticResource PrimaryButton}" Command="{Binding BuildCommand}" IsEnabled="{Binding CanBuild}"/>
                                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelBuildCommand}"/>
                                            <Button Content="Open output" Style="{StaticResource GhostButton}" Command="{Binding OpenOutputCommand}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Stage}" Margin="0,8,0,8"/>
                                        <ProgressBar Maximum="7" Value="{Binding StageIndex}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="LOG" Style="{StaticResource Eyebrow}" Margin="0,4,0,8"/>
                                <ListBox ItemsSource="{Binding LogLines}" Height="200"/>
                            </StackPanel>

                            <StackPanel x:Name="PageHistory" Visibility="Collapsed">
                                <TextBlock Text="ARCHIVE" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="{Binding NavHistory}" Style="{StaticResource Title}" Margin="0,0,0,18"/>
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="{Binding DataContext.RebuildLabel, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Command="{Binding DataContext.BuildAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                                        <TextBlock Text="{Binding OutputPath}" Style="{StaticResource Muted}"/>
                                                        <TextBlock Text="{Binding Error}" Style="{StaticResource Muted}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="PageFormats" Visibility="Collapsed">
                                <TextBlock Text="CAPABILITY" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="{Binding NavFormats}" Style="{StaticResource Title}"/>
                                <TextBlock Text="{Binding FormatsIntro}" Style="{StaticResource Muted}" Margin="0,10,0,18" MaxWidth="560"/>
                                <ItemsControl ItemsSource="{Binding Formats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Language}" FontSize="18" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Level}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Extensions}" Style="{StaticResource Muted}"/>
                                                        <TextBlock Text="{Binding Method}" Margin="0,8,0,0"/>
                                                        <TextBlock Text="{Binding Tools}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Caveat}" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="PageInstall" Visibility="Collapsed">
                                <TextBlock Text="OFFICIAL ONLY" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="{Binding NavInstall}" Style="{StaticResource Title}"/>
                                <TextBlock Text="{Binding InstallIntro}" Style="{StaticResource Muted}" Margin="0,10,0,18" MaxWidth="640"/>
                                <ItemsControl ItemsSource="{Binding Tools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Background="#14C6A15B" BorderBrush="#40C6A15B" BorderThickness="1" CornerRadius="999" Padding="10,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding State}" FontSize="11"/>
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="{Binding Name}"/><Run Text="   "/><Run Text="{Binding Vendor}" Foreground="#9996A0" FontSize="13"/></TextBlock>
                                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Margin="0,12,0,0"><Run Text="Required  " Foreground="#9996A0"/><Run Text="{Binding RequiredVersion}"/><Run Text="      Installed  " Foreground="#9996A0"/><Run Text="{Binding Version}"/></TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                        <Button Content="{Binding OfficialSiteLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"/>
                                                        <Button Content="{Binding InstallGuideLabel}" Style="{StaticResource GhostButton}" Command="{Binding DataContext.GuideToolCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"/>
                                                        <Button Content="{Binding RecheckLabel}" Style="{StaticResource GhostButton}" Command="{Binding DataContext.RecheckCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="PageSettings" Visibility="Collapsed" MaxWidth="640">
                                <TextBlock Text="PREFERENCES" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="{Binding NavSettings}" Style="{StaticResource Title}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding OutputPathLabel}" Style="{StaticResource FactLabel}"/>
                                        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding ArchitectureLabel}" Style="{StaticResource FactLabel}" Margin="0,16,0,4"/>
                                        <ComboBox ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArchitecture}" HorizontalAlignment="Left" MinWidth="220"/>
                                        <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource FactLabel}" Margin="0,16,0,4"/>
                                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code" DisplayMemberPath="Name" SelectedValue="{Binding LanguageCode}" HorizontalAlignment="Left" MinWidth="220"/>
                                        <TextBlock Text="{Binding ThemeName}" Style="{StaticResource Muted}" Margin="0,16,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}"/>
                                            <Button Content="{Binding ClearLogsLabel}" Style="{StaticResource GhostButton}" Command="{Binding ClearLogsCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PageAccount" Visibility="Collapsed" MaxWidth="520">
                                <TextBlock Text="ACCOUNT" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="{Binding AccountTitle}" Style="{StaticResource Title}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding AccountIntro}" Style="{StaticResource Muted}"/>
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding SignedOut, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding EmailLabel}" Style="{StaticResource FactLabel}"/>
                                        <TextBox Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FactLabel}" Margin="0,16,0,4"/>
                                        <PasswordBox x:Name="LoginPassword" Padding="8,7"/>
                                        <CheckBox Content="{Binding RememberLabel}" IsChecked="{Binding RememberMe}" Margin="0,14,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Content="{Binding SignInLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=LoginPassword}"/>
                                            <Button Content="{Binding CreateAccountLabel}" Style="{StaticResource GhostButton}" Command="{Binding OpenSiteCommand}" CommandParameter="site"/>
                                            <Button Content="{Binding ForgotLabel}" Style="{StaticResource GhostButton}" Command="{Binding OpenSiteCommand}" CommandParameter="site"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding SignedIn, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding EmailLabel}" Style="{StaticResource FactLabel}"/>
                                        <TextBlock Text="{Binding AccountEmail}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AccountVerified}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding PlanLabel}" Style="{StaticResource FactLabel}" Margin="0,16,0,4"/>
                                        <TextBlock Text="{Binding AccountPlan}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DeviceStatus}" Style="{StaticResource Muted}" Margin="0,16,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Content="{Binding RegisterDeviceLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding OpenSiteCommand}" CommandParameter="device"/>
                                            <Button Content="{Binding RecheckDeviceLabel}" Style="{StaticResource GhostButton}" Command="{Binding CheckDeviceCommand}"/>
                                            <Button Content="{Binding SignOutLabel}" Style="{StaticResource GhostButton}" Command="{Binding LogoutCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding AccountMessage}" Foreground="#B3453E" Margin="0,12,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="PageAbout" Visibility="Collapsed" MaxWidth="680">
                                <TextBlock Text="PRODUCT" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="COMPIVOX" Style="{StaticResource Title}"/>
                                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AboutLine1}" FontSize="16"/>
                                        <TextBlock Text="{Binding AboutLine2}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
        <Grid x:Name="IntroOverlay" Background="#000000">
            <StackPanel x:Name="IntroLogo" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="IntroScale" ScaleX="0.94" ScaleY="0.94"/>
                </StackPanel.RenderTransform>
                <Border Width="72" Height="72" CornerRadius="18" Background="#C6A15B" HorizontalAlignment="Center">
                    <TextBlock Text="C" FontSize="30" FontWeight="SemiBold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="COMPIVOX" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
