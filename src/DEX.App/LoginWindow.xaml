<Window x:Class="DEX.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COMPIVOX" Width="1360" Height="900" ResizeMode="NoResize"
        WindowStyle="None" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="#66E5C98A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.985" ScaleY="0.985" CenterX="0" CenterY="0"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F3DDA6" Offset="0"/>
                        <GradientStop Color="{StaticResource SoftGoldColor}" Offset="0.55"/>
                        <GradientStop Color="#96743D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ChampagneBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="1100" Height="760" Canvas.Left="-260" Canvas.Top="-300" Opacity="0.7">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6EC07A36" Offset="0"/>
                        <GradientStop Color="#28704A1E" Offset="0.55"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LoginAuraWarmScale" CenterX="550" CenterY="380"/>
                        <TranslateTransform x:Name="LoginAuraWarmX"/>
                        <TranslateTransform x:Name="LoginAuraWarmY"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="1000" Height="720" Canvas.Left="720" Canvas.Top="420" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3AB8762F" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LoginAuraSoftScale" CenterX="500" CenterY="360"/>
                        <TranslateTransform x:Name="LoginAuraSoftX"/>
                        <TranslateTransform x:Name="LoginAuraSoftY"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
                <Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Border Width="580" Height="620" Padding="48"
                    Background="#F20B0A0F" BorderBrush="#4DC6A15B" BorderThickness="1"
                    CornerRadius="{StaticResource DialogCornerRadius}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="0" Opacity="0.55"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MouseLeftButtonDown="OnDragStart">
                        <TextBlock Text="DESKTOP ACCOUNT" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32"
                                Click="OnCancel" Style="{StaticResource GhostButton}" FontSize="14" ToolTip="닫기"/>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MouseLeftButtonDown="OnDragStart">
                        <Image x:Name="Emblem" Width="104" Height="104" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,22"/>
                        <TextBlock Text="COMPIVOX" Foreground="{StaticResource ChampagneBrush}" FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                        <TextBlock Text="계정에 연결하세요" Foreground="{StaticResource TextBrush}" FontSize="21" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,24,0,0"/>
                        <TextBlock Text="웹사이트에서 계정을 만들거나 로그인하면&#x0a;COMPIVOX 앱으로 안전하게 돌아옵니다."
                                   Foreground="{StaticResource MutedBrush}" FontSize="14" TextAlignment="Center"
                                   Margin="0,12,0,0" LineHeight="22"/>
                        <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource TextBrush}" FontSize="13"
                                   TextAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap"
                                   MaxWidth="430" Visibility="Collapsed"/>
                    </StackPanel>

                    <Button Grid.Row="2" x:Name="WebLoginButton" Content="웹사이트에서 로그인 / 회원가입"
                            Style="{StaticResource GoldButton}" Click="OnWebLogin" Margin="0,0,0,24"/>

                    <TextBlock Grid.Row="3" Text="© COMPIVOX" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
